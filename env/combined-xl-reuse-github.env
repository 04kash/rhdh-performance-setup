# Combined XL ingest on memory-constrained clusters (8Gi pod limit).
# Same entity targets as official large_scale_xl_compare_test:
#   30k users, 500k groups, 35k Components, 35k APIs
#
# Requires stock backstage-performance after scripts/apply-overlay.sh.
# GitHub catalog YAML must be pre-pushed (see README).

export SKIP_GITHUB=false
export PRE_LOAD_DB=false
export RBAC_POLICY_UPLOAD_TO_GITHUB=false

export BACKSTAGE_USER_COUNT=30000
export GROUP_COUNT=500000
export API_COUNT=35000
export COMPONENT_COUNT=35000

export AUTH_PROVIDER=keycloak
export RBAC_POLICY=all_groups_admin_inherited
export ENABLE_RBAC=true
export ENABLE_ORCHESTRATOR=false

export RHDH_INSTALL_METHOD=helm
export RHDH_BASE_VERSION=2.0

# Override per run (do not commit real namespace/passwords in git)
export RHDH_NAMESPACE="${RHDH_NAMESPACE:-rhdh-performance-xl}"
export KEYCLOAK_USER_PASS="${KEYCLOAK_USER_PASS:-changeme}"
export KEYCLOAK_DB_PASSWORD="${KEYCLOAK_DB_PASSWORD:-changeme}"

export RHDH_DEPLOYMENT_REPLICAS=1
export RHDH_DB_STORAGE=100Gi
export RHDH_RESOURCES_MEMORY_REQUESTS=4Gi
export RHDH_RESOURCES_MEMORY_LIMITS=8Gi
export RHDH_NODEJS_MAX_HEAP_SIZE=6144

# LDAP full read+commit at 500k groups exceeds default PT50M
export LDAP_SCHEDULE_TIMEOUT=PT6H
export ENSURE_CATALOG_POPULATION_TIMEOUT=25200
export CATALOG_REFRESH_INTERVAL_MINUTES=10080
export RHDH_STARTUP_TIMEOUT_SECONDS=21600
export RHDH_LOG_LEVEL=debug
export RHDH_METRIC=true
