# Scenario 1: LDAP-only XL ingest (30k users, 500k groups, no GitHub catalog entities)
export SKIP_GITHUB=true
export PRE_LOAD_DB=false
export RBAC_POLICY_UPLOAD_TO_GITHUB=false

export BACKSTAGE_USER_COUNT=30000
export GROUP_COUNT=500000
export API_COUNT=0
export COMPONENT_COUNT=0

export AUTH_PROVIDER=keycloak
export KEYCLOAK_USER_PASS=changeme
export RBAC_POLICY=all_groups_admin_inherited
export ENABLE_RBAC=true
export ENABLE_ORCHESTRATOR=false

export RHDH_INSTALL_METHOD=helm
export RHDH_BASE_VERSION=2.0
export RHDH_NAMESPACE="${RHDH_NAMESPACE:-rhdh-performance}"
export RHDH_DEPLOYMENT_REPLICAS=3
export RHDH_DB_STORAGE=100Gi
export RHDH_RESOURCES_MEMORY_REQUESTS=31Gi
export RHDH_RESOURCES_MEMORY_LIMITS=31Gi
export RHDH_NODEJS_MAX_HEAP_SIZE=30720

export LDAP_SCHEDULE_TIMEOUT=PT10H
export ENSURE_CATALOG_POPULATION_TIMEOUT=43200
export CATALOG_REFRESH_INTERVAL_MINUTES=10080
export RHDH_STARTUP_TIMEOUT_SECONDS=28800
export RHDH_LOG_LEVEL=debug
export RHDH_METRIC=true
